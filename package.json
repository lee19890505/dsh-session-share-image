{
  "name": "dsh-session-share-image",
  "version": "1.0.1",
  "description": "Export selected DeepSeek Harness conversation messages as one shareable PNG image",
  "license": "MIT",
  "keywords": ["dsh", "deepseek-harness", "plugin", "session", "export", "image"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lee19890505/dsh-session-share-image.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
